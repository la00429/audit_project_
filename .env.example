# AuditTest Vision — Environment Configuration
# Copy this file to .env and fill in your values

# API Key for Vision LLM and Auto-Fix services
AUDITTEST_API_KEY=your_api_key_here

# Vision analysis API endpoint
VISION_API_ENDPOINT=https://api.audittest.local/v1/vision

# Auto-fix generation API endpoint
AUTOFIX_API_ENDPOINT=https://api.audittest.local/v1/autofix

# Audit service URL (for git hook CLI)
AUDITTEST_URL=http://localhost:3000

# Max critical issues before blocking git push (0 = block any critical)
AUDITTEST_MAX_CRITICAL=0

# Headless browser timeout in seconds
AUDITTEST_TIMEOUT=30
