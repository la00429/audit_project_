{
  "name": "audittest-vision",
  "version": "1.0.0",
  "description": "Herramienta CLI de auditoria visual y accesibilidad web automatizada para desarrolladores",
  "main": "dist/core/auditEngine.js",
  "type": "module",
  "bin": {
    "audittest-vision": "./dist/cli/audittest.js"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/la00429/audit_project_.git"
  },
  "homepage": "https://la00429.github.io/audit_project_/",
  "scripts": {
    "build": "tsc --project tsconfig.extension.json",
    "postbuild": "node scripts/copy-assets.js",
    "build:check": "tsc --noEmit",
    "icons": "node scripts/generate-icons.js",
    "lint": "eslint src/**/*.ts",
    "clean": "rimraf dist",
    "package": "npm run clean && npm run build && npm run postbuild"
  },
  "keywords": [
    "audit",
    "qa",
    "accessibility",
    "wcag",
    "vision",
    "chrome-extension",
    "auto-fix"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/node": "^20.19.43",
    "eslint": "^9.0.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "puppeteer": "^22.0.0"
  }
}
