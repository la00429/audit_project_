{
  "name": "audittest-vision",
  "version": "1.0.0",
  "description": "AI-powered QA auditing tool combining Vision LLM analysis, WCAG checks, and Auto-Fix capabilities",
  "main": "dist/core/auditEngine.js",
  "scripts": {
    "build": "tsc --project tsconfig.extension.json",
    "postbuild": "node scripts/copy-assets.js",
    "build:check": "tsc --noEmit",
    "icons": "node scripts/generate-icons.js",
    "lint": "eslint src/**/*.ts",
    "clean": "rimraf dist",
    "package": "npm run clean && npm run build && npm run postbuild"
  },
  "keywords": ["audit", "qa", "accessibility", "wcag", "vision", "chrome-extension", "auto-fix"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "eslint": "^9.0.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "puppeteer": "^22.0.0"
  }
}
